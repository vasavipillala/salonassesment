# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL is default, SQLite is supported for zero-setup local dev)
DB_TYPE=postgres

# PostgreSQL Connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=salon_booking
PGUSER=postgres
PGPASSWORD=postgres
# Or full connection URL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salon_booking

# SQLite fallback path (used when DB_TYPE=sqlite or postgres is unavailable)
SQLITE_DB_PATH=./database/salon_dev.sqlite
