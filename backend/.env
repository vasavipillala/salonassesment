# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL primary, automatic graceful fallback to SQLite for zero-setup portability)
DB_TYPE=auto

# PostgreSQL Connection settings
PGHOST=localhost
PGPORT=5432
PGDATABASE=salon_booking
PGUSER=postgres
PGPASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salon_booking

# SQLite fallback path
SQLITE_DB_PATH=./data/salon_dev.sqlite
